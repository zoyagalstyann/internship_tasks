generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  tasks Task[]
}

model Task {
  id          Int          @id @default(autoincrement())
  title       String
  description String?
  status      String       @default("pending")
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  categories  Category[]
}

model Category {
  id          Int    @id @default(autoincrement())
  title       String
  description String?
  tasks       Task[]
}